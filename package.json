{
  "name": "revex-code",
  "version": "1.0.0",
  "description": "REVEX CODE — локальний AI-кодер для Windows (Ollama + Monaco)",
  "main": "src/main/main.js",
  "author": "REVEX",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js && node tests/ollama-mock.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.revex.code",
    "productName": "REVEX CODE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/monaco-editor/dev/**",
      "!node_modules/monaco-editor/esm/**",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "REVEX-CODE-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "REVEX-CODE-Portable-${version}.exe"
    }
  }
}
